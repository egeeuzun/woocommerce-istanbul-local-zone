# terraform.tfvars olarak kopyalayin (*.tfvars git'e girmez).

admin_extra_allowed_cidrs = ["203.0.113.4/32"]

# WordPress yonetici (admin) parolasi. Yorumda = Terraform rastgele uretir:
#   aws ssm get-parameter --with-decryption --query Parameter.Value --output text \
#     --name $(terraform output -raw admin_password_ssm_name)
# Verilirse SSM'e yazilir, task'lar yenilenir ve imaj parolayi esitler.
# wp_admin_password = "admin123"

# Calistirilacak imaj. Bos/yorumda = <ecr_repository_url>:latest
# image_tag = "c6d08b7"

# Imaj build/deploy hatti (opsiyonel). Kapaliyken imaj elle push edilir ve
# image_tag ile secilir (README). Acmak icin once konsolda bir CodeStar
# baglantisi olusturup onaylayin, ARN'ini buraya yazin:
# enable_cicd             = true
# codestar_connection_arn = "arn:aws:codestar-connections:eu-central-1:<HESAP>:connection/<ID>"
# repository_id           = "<kullanici>/wordpress-shop-demo"
# branch                  = "main"

# Istanbul'da NAT gateway destegi dogrulanirsa:
# nat_in_local_zone = true
